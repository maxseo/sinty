{$ROOT_DOMAIN} {
    header Content-Type "text/html; charset=utf-8"
    header Referrer-Policy "no-referrer"
    respond <<HTML
<!doctype html><html lang="ru"><meta charset="utf-8"><meta name="viewport" content="width=device-width"><title>Sinty</title><style>body{font:18px system-ui;max-width:52rem;margin:15vh auto;padding:2rem;background:#10141d;color:#edf2fa}a{color:#8ac7ff}</style><h1>Sinty</h1><p>Место для будущего сайта.</p><a href="https://{$APP_DOMAIN}/">Войти в Sinty</a><p>Используется существующий вход харнеса, без отдельной регистрации на сайте.</p></html>
HTML 200
}
{$APP_DOMAIN} {
    header Referrer-Policy "no-referrer"
    header X-Content-Type-Options "nosniff"
    # No public first-admin takeover. Bootstrap is an interactive, offline container command.
    @publicSetup {
        method POST
        path /v1/auth/setup
    }
    respond @publicSetup "Bootstrap is local-only" 403
    @crossOrigin {
        path /v1/* /p/* /ui/*
        header Origin *
        not header Origin https://{$APP_DOMAIN}
    }
    respond @crossOrigin "Origin not allowed" 403
    request_body {
        max_size 64MB
    }
    reverse_proxy sinty:3180 {
        flush_interval -1
        header_up -X-Forwarded-User
    }
}
