{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/maxseo/sinty/main/schemas/plugin-manifest.schema.json",
  "title": "Sinty plugin manifest",
  "type": "object",
  "required": ["name", "version", "description", "kinds", "runtime", "permissions"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.-]+)?$" },
    "description": { "type": "string", "minLength": 1, "maxLength": 300 },
    "kinds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["provider", "tool", "context", "channel", "server", "schedule", "event", "ui", "memory"] }
    },
    "runtime": { "enum": ["node", "mcp-stdio", "http"] },
    "entry": { "type": "string" },
    "command": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "url": { "type": "string", "format": "uri" },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fs": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "read": { "type": "array", "items": { "type": "string" } },
            "write": { "type": "array", "items": { "type": "string" } }
          }
        },
        "net": { "type": "array", "items": { "type": "string" } },
        "secrets": { "type": "array", "items": { "type": "string" } },
        "env": { "type": "array", "items": { "type": "string" } },
        "shell": { "type": "boolean" },
        "agent": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["sessions.read", "sessions.write"] },
          "description": "Talk to the agent through ctx.agent: read sessions and live streams, create sessions and send messages"
        },
        "models": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 },
          "description": "Model routes the plugin may call through ctx.models: default, cheap, embed, a models.routes key, or * for any"
        },
        "context": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["inspect"] },
          "description": "inspect: receive a context snapshot (the full prompt of every model step) through ctx.onContextSnapshot; the human must also list the plugin in config.yaml plugins.inspect"
        }
      }
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "sideEffects"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*(\\.[a-z][a-z0-9_-]*)+$" },
          "description": { "type": "string" },
          "sideEffects": { "enum": ["none", "read", "write", "external"] },
          "idempotent": { "type": "boolean" },
          "recoverable": { "type": "boolean" },
          "docs": { "type": "string" },
          "defaultPolicy": { "enum": ["allow", "ask", "deny"] }
        }
      }
    },
    "config": { "type": "object" },
    "tests": { "type": "string" },
    "editable": { "type": "boolean", "default": true },
    "ui": {
      "type": "object",
      "anyOf": [{ "required": ["static"] }, { "required": ["tabs"] }],
      "additionalProperties": false,
      "properties": {
        "static": { "type": "string", "minLength": 1, "description": "folder with static files served at /ui/<name>/; only for editable: false" },
        "tabs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "description": "Web UI tabs: each loads a public GET route of the plugin in a sandboxed iframe (no same-origin); data reaches it only through the UI's postMessage bridge",
          "items": {
            "type": "object",
            "required": ["id", "title", "path"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$" },
              "title": { "type": "string", "minLength": 1, "maxLength": 40 },
              "path": { "type": "string", "maxLength": 200, "pattern": "^/[A-Za-z0-9_\\-./]*$", "description": "route relative to /p/<plugin>, e.g. /tab" },
              "placement": {
                "enum": ["sidebar", "session"],
                "default": "sidebar",
                "description": "sidebar: a page in the left navigation; session: a view toggle in an open chat's header (next to Чат/Журнал), told the current sessionId by the bridge"
              }
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "required": ["runtime"], "properties": { "runtime": { "const": "node" }, "kinds": { "contains": { "not": { "const": "ui" } } } } },
      "then": { "required": ["entry"] }
    },
    { "if": { "properties": { "runtime": { "const": "mcp-stdio" } } }, "then": { "required": ["command"] } },
    { "if": { "properties": { "runtime": { "const": "http" } } }, "then": { "required": ["url"] } }
  ]
}
