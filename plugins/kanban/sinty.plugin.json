{
  "$schema": "../../schemas/plugin-manifest.schema.json",
  "name": "kanban",
  "version": "0.1.0",
  "description": "Kanban board for a project: assignee, reviewer, dependencies, and notes in the team chat",
  "kinds": ["tool", "server", "event"],
  "runtime": "node",
  "entry": "dist/index.js",
  "permissions": {
    "fs": { "write": ["$DATA"] },
    "agent": ["sessions.read", "sessions.write"]
  },
  "tools": [
    { "name": "kanban.list", "sideEffects": "read", "idempotent": true, "docs": "README.md" },
    { "name": "kanban.create", "sideEffects": "write", "idempotent": false, "docs": "README.md" },
    { "name": "kanban.update", "sideEffects": "write", "idempotent": false, "docs": "README.md" }
  ],
  "config": { "maxParallel": { "type": "integer", "default": 3, "description": "cards the agent works on at the same time" } },
  "ui": { "tabs": [{ "id": "board", "title": "Канбан", "builtin": "board" }] },
  "editable": true
}
