{
  "name": "net-public",
  "version": "0.0.1",
  "description": "Calls ctx.net.public for the netguard tests",
  "kinds": ["tool"],
  "runtime": "node",
  "entry": "index.js",
  "permissions": { "net": ["$PUBLIC"] },
  "tools": [
    { "name": "net.get", "sideEffects": "external" },
    { "name": "net.check", "sideEffects": "external" },
    { "name": "net.raw", "sideEffects": "external" },
    { "name": "net.proxy", "sideEffects": "external" }
  ]
}
